<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose frame="">0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>2500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>2.5</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://10by10</uri>
    </include>

    <!--
      Scene 1 v2: middle static-obstacle cooperation scenario.
      Design goal:
        1) Increase obstacle interaction compared with Scene 0.
        2) Keep at least two feasible bypass routes around the center.
        3) Avoid an overly narrow single corridor in the first version.
      Obstacles are defined directly in this world to avoid dependency on
      obstacle*/model.sdf default poses.
    -->

    <!-- Large lower-left central block. Forces left/right and lower bypass decisions. -->
    <model name="obstacle1">
      <pose>-1.75 -1.55 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>1.50 1.20 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>1.50 1.20 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Upper-left short horizontal wall. v2: moved slightly outward to widen central passage. -->
    <model name="obstacle2">
      <pose>-1.35 1.35 0 0 0 1.5708</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.30 0.90 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.30 0.90 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Upper-middle vertical wall. Works with obstacle2 to create a bend, not a dead-end. -->
    <model name="obstacle3">
      <pose>0.85 1.20 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.30 0.90 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.30 0.90 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Small lower-middle blocker. v2: moved slightly outward to ease first-stage passage. -->
    <model name="obstacle4">
      <pose>0.85 -0.95 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.35 0.55 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.35 0.55 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

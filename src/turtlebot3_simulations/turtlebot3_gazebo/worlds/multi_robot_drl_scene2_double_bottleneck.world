<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose frame="">0.10 -0.15 9.60 0 1.5138 0.00</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>2500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>2.5</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://10by10</uri>
    </include>

    <!--
      Scene 2: double-bottleneck eval-only world, balanced v3.

      Purpose:
        - Unseen eval-only layout for Scene1b-trained policies.
        - Different from Scene1 / Scene1b: six mixed-shape obstacles, two selectable
          upper/lower bottleneck routes, plus a staggered S-like central passage.
        - Left/right side spaces are kept more balanced than v1.

      v3 changes requested:
        - obstacle1 / obstacle2 / obstacle5 shifted upward.
        - obstacle3 / obstacle4 / obstacle6 shifted downward by the same amount.
        - obstacle5 shifted left and obstacle6 shifted right by about one obstacle width,
          increasing the middle gap while preserving the staggered S-like passage.

      Suggested sampler notes:
        - Left entrance:   x ~= -4.0, y in {-1.2, 0.0, +1.2}
        - Right entrance:  x ~= +4.0, y in {-1.2, 0.0, +1.2}
        - Upper route:     -3.6 < x < +3.6,  1.45 < y < 2.20
        - Lower route:     -3.6 < x < +3.6, -2.20 < y < -1.45
        - Central S route: around obstacle5(-1.30, +0.90) and obstacle6(+1.30, -0.90).

      Do not use this world for training unless explicitly starting a new curriculum stage.
    -->

    <!-- obstacle1: upper-left rectangular gate block. -->
    <model name="obstacle1">
      <pose>-2.70 2.75 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.15 0.90 1.00</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.15 0.90 1.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- obstacle2: upper-right circular gate block. -->
    <model name="obstacle2">
      <pose>2.30 2.70 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.00</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.00</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- obstacle3: lower-left circular gate block. -->
    <model name="obstacle3">
      <pose>-2.30 -2.70 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.00</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.00</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- obstacle4: lower-right rectangular gate block. -->
    <model name="obstacle4">
      <pose>2.70 -2.75 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.15 0.90 1.00</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>1.15 0.90 1.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- obstacle5: central-left vertical island, shifted upward and left. -->
    <model name="obstacle5">
      <pose>-1.10 0.50 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.55 1.20 1.00</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.55 1.20 1.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- obstacle6: central-right vertical island, shifted downward and right. -->
    <model name="obstacle6">
      <pose>1.10 -0.50 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.55 1.20 1.00</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.50 0 0 0</pose>
          <geometry><box><size>0.55 1.20 1.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

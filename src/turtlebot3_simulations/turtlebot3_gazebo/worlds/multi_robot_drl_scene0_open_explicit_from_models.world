<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose frame="">0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>2000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>2</real_time_factor>
      <ode>
        <solver>
          <type>quick</type><iters>150</iters><precon_iters>0</precon_iters>
          <sor>1.400000</sor><use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://10by10</uri></include>

    <!--
      Scene0/open baseline, explicit obstacle geometry.
      Geometry and pose are copied from the obstacle model files supplied by the user,
      but written directly here so this world does not depend on obstacle*/model.sdf default poses.
    -->

    <model name="obstacle1">
      <pose>2.86 -3.0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.166667</iyy><iyz>0</iyz><izz>0.166667</izz></inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry><max_contacts>10</max_contacts></collision>
        <visual name="visual"><geometry><box><size>1 1 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="obstacle2">
      <pose>-2.93 3.17 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.166667</iyy><iyz>0</iyz><izz>0.166667</izz></inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision"><geometry><box><size>0.3 0.7 1</size></box></geometry><max_contacts>10</max_contacts></collision>
        <visual name="visual"><geometry><box><size>0.3 0.7 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="obstacle3">
      <pose>-2.93 -3.0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.166667</iyy><iyz>0</iyz><izz>0.166667</izz></inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision"><geometry><box><size>0.25 0.25 1</size></box></geometry><max_contacts>10</max_contacts></collision>
        <visual name="visual"><geometry><box><size>0.25 0.25 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="obstacle4">
      <pose>2.83 2.93 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.166667</iyy><iyz>0</iyz><izz>0.166667</izz></inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision"><geometry><box><size>2 1.5 1</size></box></geometry><max_contacts>10</max_contacts></collision>
        <visual name="visual"><geometry><box><size>2 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>
